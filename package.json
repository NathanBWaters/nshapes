{
  "name": "nshapes",
  "version": "0.1.175",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --watchAll=false __tests__/eslintPerfPlugin.test.ts __tests__/performanceLifecycle.test.tsx",
    "test:fast": "jest --watchAll=false --testPathIgnorePatterns=adventureBalance --testPathIgnorePatterns=adventureBuilds --testPathIgnorePatterns=adventurePower --testPathIgnorePatterns=Tuner --testPathIgnorePatterns=adventureAnalytics --testPathIgnorePatterns=adventureFullGameE2E",
    "test:e2e:adventure": "jest --watchAll=false __tests__/adventureFullGameE2E.test.tsx",
    "test:e2e:battery": "playwright test e2e/battery-budget.spec.ts --project=chromium --reporter=list",
    "test:e2e:layout": "playwright test e2e/layout-text-visibility.spec.ts --project=chromium --reporter=list",
    "test:e2e:spire": "playwright test e2e/spire-and-parry.spec.ts e2e/menu-resume-integration.spec.ts --project=chromium --reporter=list",
    "test:e2e:prism": "playwright test e2e/prism-deck.spec.ts --project=chromium --reporter=list",
    "test:e2e:ci": "playwright test e2e/battery-budget.spec.ts e2e/layout-text-visibility.spec.ts e2e/spire-and-parry.spec.ts e2e/menu-resume-integration.spec.ts e2e/prism-deck.spec.ts --project=chromium --reporter=list",
    "verify:guardrails": "npm run typecheck && npm run lint && npm run validate:icons && npm run validate:balance-eras && npm run validate:store && npm run test:perf",
    "verify:ci": "node scripts/agy-ci-hook.js check",
    "typecheck": "tsc --noEmit",
    "validate:icons": "npx tsx scripts/validate-icons.ts",
    "validate:balance-eras": "npx tsx scripts/balance-eras.ts check",
    "validate:store": "npx tsx scripts/validate-store-readiness.ts",
    "store:assets": "node scripts/store/generate-brand-assets.mjs",
    "store:screenshots": "node scripts/store/generate-screenshots.mjs",
    "mobile:doctor": "npx --yes expo-doctor",
    "mobile:prebuild:check": "CI=1 npx expo prebuild --clean --no-install && rm -rf ios android",
    "mobile:build:preview": "npx eas-cli build --platform all --profile preview",
    "mobile:build:ios": "npx eas-cli build --platform ios --profile production",
    "mobile:build:android": "npx eas-cli build --platform android --profile production",
    "mobile:build:prod": "npx eas-cli build --platform all --profile production",
    "mobile:submit:ios": "npx eas-cli submit --platform ios --profile production",
    "mobile:submit:android": "npx eas-cli submit --platform android --profile production",
    "mobile:update:prod": "npx eas-cli update --branch production",
    "fights:replay": "jest __tests__/fightReplayTool.test.ts",
    "balance:report": "BALANCE_REPORT=1 jest __tests__/adventureBalanceLab.test.ts",
    "balance:atlas": "BALANCE_ATLAS=1 jest __tests__/adventureAnalytics.test.ts",
    "balance:levels": "ADVENTURE_BALANCE_REPORT=1 jest __tests__/adventureBalance.test.ts",
    "balance:spire": "SPIRE_BALANCE_REPORT=1 jest __tests__/spireBalance.test.ts",
    "balance:tune": "BALANCE_TUNE=1 jest __tests__/adventureBalanceTuner.test.ts",
    "balance:power": "npx tsx scripts/balance-power-rank.ts",
    "balance:calibrate-bot": "npx tsx scripts/balance-calibrate-bot.ts",
    "balance:gauntlet": "npx tsx scripts/balance-gauntlet.ts",
    "balance:era:check": "npx tsx scripts/balance-eras.ts check",
    "balance:era:record": "npx tsx scripts/balance-eras.ts record",
    "balance:era:status": "npx tsx scripts/balance-eras.ts status",
    "analytics:export": "npx tsx scripts/posthog-dashboards.ts export",
    "analytics:posthog:sync": "npx tsx scripts/posthog-dashboards.ts sync",
    "analytics:posthog:pull": "npx tsx scripts/posthog-dashboards.ts pull",
    "analytics:posthog:pull-balance": "npx tsx scripts/posthog-dashboards.ts pull-balance",
    "motion:shots": "node scripts/motion/capture.mjs --list",
    "motion:capture": "node scripts/motion/capture.mjs",
    "motion:sheet": "node scripts/motion/sheet.mjs",
    "motion:analyze": "node scripts/motion/analyze.mjs",
    "motion:flipbook": "node scripts/motion/flipbook.mjs",
    "prebuild": "npm run typecheck"
  },
  "react-native-audio-api": {
    "enableFFmpeg": false
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.14",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "^1.0.1",
    "react-native-copilot": "^3.3.3",
    "react-native-mmkv": "^4.1.0",
    "react-native-nitro-modules": "0.32.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/uuid": "^9.0.3",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-native-svg-transformer": "^1.5.2",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  }
}
